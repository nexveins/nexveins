# Public site URL
NEXT_PUBLIC_SITE_URL=https://nexveins.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@nexveins.com

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-30

# Lead delivery
RESEND_API_KEY=
LEAD_RECIPIENT_EMAIL=
LEAD_FROM_EMAIL=Nexveins <leads@your-verified-domain.com>

# Booking handoff
NEXT_PUBLIC_CAL_URL=

# Cloudflare Turnstile (optional in local development, required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Distributed rate limiting (optional; an in-process fallback is used without these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privacy-friendly analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

